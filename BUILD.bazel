# Root BUILD file for cucumber-cpp
# Exports headers for use by src/ package
# Cucumber-Cpp Bazel BUILD file
# BDD testing framework with Cucumber/Gherkin for C++

package(default_visibility = ["//visibility:public"])

# Export all headers as a filegroup
filegroup(
    name = "headers",
    srcs = glob(["include/**/*.hpp"]),
)

# Core cucumber-cpp source files (relative to src/ directory)
CUKE_SOURCES = [
    "src/drivers/GenericDriver.cpp",
    "src/drivers/GTestDriver.cpp",  # Enable GTest support
    "src/ContextManager.cpp",
    "src/CukeCommands.cpp",
    "src/CukeEngine.cpp",
    "src/CukeEngineImpl.cpp",
    "src/StepManager.cpp",
    "src/HookRegistrar.cpp",
    "src/Regex.cpp",
    "src/Scenario.cpp",
    "src/Table.cpp",
    "src/Tag.cpp",
    # Wire protocol needed for rules_gherkin
    "src/connectors/wire/WireServer.cpp",
    "src/connectors/wire/WireProtocol.cpp",
    "src/connectors/wire/WireProtocolCommands.cpp",
]

# Main cucumber-cpp library (with main() for wire protocol server)
# This is the target that rules_gherkin expects as //src:cucumber_main
cc_library(
    name = "cucumber_main",
    srcs = CUKE_SOURCES + ["src/main.cpp"] + ["//:headers"],
    includes = ["include"],
    copts = [
        "-std=c++17",
        "-DCUCUMBER_CPP_STATIC_DEFINE",  # Static library define
        "-DCUKE_ENABLE_GTEST=1",  # Enable GTest support
        "-DCUKE_VERSION=\\\"0.6.0\\\"",  # Version for main.cpp
    ],
    deps = [
        "@gtest//:gtest",  # GTest dependency
        "@nlohmann_json//:json",  # JSON library
        "@asio",  # ASIO for wire protocol server
        "@tclap",  # Command-line argument parser
    ],
    linkopts = select({
        "@platforms//os:linux": ["-lpthread"],
        "@platforms//os:macos": [],
        "//conditions:default": [],
    }),
    alwayslink = True,  # Ensure all symbols are available for step definitions
)

# Alternative: Library without main() for custom test runners
cc_library(
    name = "cucumber_cpp_nomain",
    srcs = CUKE_SOURCES + ["//:headers"],
    includes = ["include"],
    copts = [
        "-std=c++17",
        "-DCUCUMBER_CPP_STATIC_DEFINE",
        "-DCUKE_ENABLE_GTEST=1",
    ],
    deps = [
        "@gtest//:gtest",
        "@nlohmann_json//:json",
        "@asio",
    ],
    linkopts = select({
        "@platforms//os:linux": ["-lpthread"],
        "@platforms//os:macos": [],
        "//conditions:default": [],
    }),
)
